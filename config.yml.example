# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
#   force_proxy_protocol: false  # optional: Xray, or this fork's sing-box AnyTLS only
#   # Accepts PROXY v1/v2 and plain TLS. Restrict the listener to trusted forwarders.
#   log_level: "none"  # disable embedded sing-box/xray operational logs; native audit remains enabled
#   # ── xray connection policy (levels.0). Recommended defaults when omitted:
#   #    handshake=4 conn_idle=35 uplink_only=3 downlink_only=5 buffer_size=128
#   #   xray_policy:
#   #     handshake: 4       # seconds
#   #     conn_idle: 35      # seconds
#   #     uplink_only: 3     # seconds
#   #     downlink_only: 5   # seconds
#   #     buffer_size: 128   # KB per connection; -1 = unlimited
#   # ── singbox connection lifecycle:
#   #   idle_timeout: 35     # seconds with no traffic before a TCP conn is
#   #                        # closed (sing-box equivalent of xray connIdle).
#   #                        # 0 = default 35, negative = disabled.
#   #   tcp_keep_alive: "15m"          # optional sing-box listen option
#   #   tcp_keep_alive_interval: "30s" # optional sing-box listen option
#   #   udp_timeout: "5m"               # optional sing-box listen option
#   #   device_limit_enforce: false     # default false: device IPs are still
#   #                                   # tracked & reported, but over-limit
#   #                                   # users are never rejected. Set true to
#   #                                   # enforce (reject new devices).
# log:
#   level: "none"      # disable xboard-node application logs
# audit:               # connection log upload to Flux; memory only, never written to disk
#   url: "https://flux.yihetang.icu/api/node-audit/v2/ingest"
#   secret: "flux-ingest-secret"  # or secret_env: "AUDIT_SECRET"
#   # Optional:
#   # site: "98k"           # default: each instance's panel domain, mapped to a site by Flux
#   # agent_id: "jp-01"     # default: hostname
#   # queue_size: 16384     # in-memory events shared by the whole process
#   # batch_size: 512       # events per signed gzip batch
# runtime:
#   # Lower = less RSS, slightly more GC CPU. Omitted = no soft cap.
#   gomemlimit: "600MiB"  # soft RSS cap; GC becomes aggressive above this
#   gogc: 70              # lower = less memory, more GC CPU (default 100)
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
